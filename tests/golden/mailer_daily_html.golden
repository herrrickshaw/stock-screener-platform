=\"section\">\n                <div class=\"section-title\">T1</div>\n                <div class=\"section-description\">D1</div>\n                <div class=\"stock-grid\">\n            <div class=\"stock-card\">\n                <div class=\"stock-symbol\">S0</div>\n                <div class=\"stock-details\">\n                    <div><span>Price:</span> <span>$10.50</span></div>\n                    <div><span>Score:</span> <span>3</span></div>\n                    <div><span>Market:</span> <span>NSE</span></div>\n                </div>\n                <span class=\"signal buy\">BUY</span>\n            </div>\n            \n            <div class=\"stock-card\">\n                <div class=\"stock-symbol\">S1</div>\n                <div class=\"stock-details\">\n                    <div><span>Price:</span> <span>$11.50</span></div>\n                    <div><span>Score:</span> <span>4</span></div>\n                    <div><span>Market:</span> <span>NSE</span></div>\n                </div>\n                <span class=\"signal watch\">WATCH</span>\n            </div>\n            \n            <div class=\"stock-card\">\n                <div class=\"stock-symbol\">S2</div>\n                <div class=\"stock-details\">\n                    <div><span>Price:</span> <span>$12.50</span></div>\n                    <div><span>Score:</span> <span>5</span></div>\n                    <div><span>Market:</span> <span>NSE</span></div>\n                </div>\n                <span class=\"signal hold\">HOLD</span>\n            </div>\n            \n            <div class=\"stock-card\">\n                <div class=\"stock-symbol\">S3</div>\n                <div class=\"stock-details\">\n                    <div><span>Price:</span> <span>$13.50</span></div>\n                    <div><span>Score:</span> <span>6</span></div>\n                    <div><span>Market:</span> <span>NSE</span></div>\n                </div>\n                <span class=\"signal buy\">BUY</span>\n            </div>\n            \n            <div class=\"stock-card\">\n                <div class=\"stock-symbol\">S4</div>\n                <div class=\"stock-details\">\n                    <div><span>Price:</span> <span>$14.50</span></div>\n                    <div><span>Score:</span> <span>7</span></div>\n                    <div><span>Market:</span> <span>NSE</span></div>\n                </div>\n                <span class=\"signal watch\">WATCH</span>\n            </div>\n            \n            <div class=\"stock-card\">\n                <div class=\"stock-symbol\">S5</div>\n                <div class=\"stock-details\">\n                    <div><span>Price:</span> <span>$15.50</span></div>\n                    <div><span>Score:</span> <span>8</span></div>\n                    <div><span>Market:</span> <span>NSE</span></div>\n                </div>\n                <span class=\"signal hold\">HOLD</span>\n            </div>\n            \n            <div class=\"stock-card\">\n                <div class=\"stock-symbol\">S6</div>\n                <div class=\"stock-details\">\n                    <div><span>Price:</span> <span>$16.50</span></div>\n                    <div><span>Score:</span> <span>9</span></div>\n                    <div><span>Market:</span> <span>NSE</span></div>\n                </div>\n                <span class=\"signal buy\">BUY</span>\n            </div>\n            \n            <div class=\"stock-card\">\n                <div class=\"stock-symbol\">S7</div>\n                <div class=\"stock-details\">\n                    <div><span>Price:</span> <span>$17.50</span></div>\n                    <div><span>Score:</span> <span>10</span></div>\n                    <div><span>Market:</span> <span>NSE</span></div>\n                </div>\n                <span class=\"signal watch\">WATCH</span>\n            </div>\n            \n            <div class=\"stock-card\">\n                <div class=\"stock-symbol\">S8</div>\n          